#version 430 core
layout(local_size_x=64) in;
struct Source {uvec4 matrix0;uvec4 matrix1;uvec4 rect;uvec4 control;};
layout(std430,binding=0) readonly buffer Sources {Source source[];};
layout(std430,binding=1) buffer Quads {uint words[];};
uniform uint count;
uniform bool ignoreOpacity;
void put(uint i,uint corner,vec3 position) {
    uint offset=i*24u+corner*6u;
    words[offset]=floatBitsToUint(position.x);
    words[offset+1u]=floatBitsToUint(position.y);
    words[offset+2u]=floatBitsToUint(position.z);
}
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=count||source[i].control.z==0u)return;
    uint flags=source[i].control.x;
    if((flags&1u)!=0u||(flags&1024u)==0u||(!ignoreOpacity&&(flags&512u)==0u)) {
        for(uint n=0u;n<4u;++n)put(i,n,vec3(0));
        return;
    }
    precise float a=uintBitsToFloat(source[i].matrix0.x),b=uintBitsToFloat(source[i].matrix0.y);
    precise float nc=uintBitsToFloat(source[i].matrix0.z^0x80000000u),d=uintBitsToFloat(source[i].matrix0.w);
    precise float tx=uintBitsToFloat(source[i].matrix1.x),ty=uintBitsToFloat(source[i].matrix1.y);
    precise float x1=uintBitsToFloat(source[i].rect.x),y1=uintBitsToFloat(source[i].rect.y);
    precise float x2=x1+uintBitsToFloat(source[i].rect.z),y2=y1+uintBitsToFloat(source[i].rect.w);
    precise float ax1=a*x1,ax2=a*x2,bx1=b*x1,bx2=b*x2;
    precise float cy1=nc*y1,cy2=nc*y2,dy1=d*y1,dy2=d*y2;
    precise float xtl=(ax1-cy2)+tx,xbl=(ax1-cy1)+tx,xtr=(ax2-cy2)+tx,xbr=(ax2-cy1)+tx;
    precise float ytl=(dy2+bx1)+ty,ybl=(bx1+dy1)+ty,ytr=(dy2+bx2)+ty,ybr=(bx2+dy1)+ty;
    float z=uintBitsToFloat(source[i].control.y);
    put(i,0u,vec3(xtl,ytl,z));put(i,1u,vec3(xbl,ybl,z));
    put(i,2u,vec3(xtr,ytr,z));put(i,3u,vec3(xbr,ybr,z));
}
