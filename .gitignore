# Only project sources and curated documentation belong in Git.
# Never traverse the game fixture (its Resources directory is a junction).
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/RESEARCH_BASELINE.md
!/research/
/research/*
!/research/R4-00/
!/research/R4-01/
!/research/R4-06/
**/*.local.json
**/*.local.txt
!/LICENSE.md
!/COPYING
!/NOTICE.md
!/THIRD_PARTY_NOTICES.md
!/LICENSES/
!/CMakeLists.txt
!/mod.json
!/logo.png
!/about.md
!/changelog.md
!/support.md
!/build-local.cmd
!/package-local.ps1
!/test-*.cmd
!/src/
!/resources/
!/tests/
!/tools/
!/docs/

**/__pycache__/
**/*.pyc
**/*.exe
**/*.dll
**/*.obj
**/*.pdb
**/*.lib
**/*.geode
**/*.log
**/*.jsonl
**/*.ppm
.env
.env.*
*.key
*.pem

