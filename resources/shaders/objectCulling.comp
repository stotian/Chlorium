#extension GL_ARB_shading_language_include:require

#include "shared.h"

layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
shared uint visibleIndexCounts[32];

//// INDEX BUFFERS ////
STORAGE_BUFFER(INPUT_INDEX_BUFFER_BINDING) InputIndexBuffer {
    uint u_inputIndicies[];
};

STORAGE_BUFFER(CULLED_INDEX_BUFFER_BINDING) CulledIndexBuffer {
    uint u_culledIndicies[];
};

/*
    This buffer contains indicies into the input sprite buffer
    that are ordered by how they should be drawn on screen.
    This buffer can change depending on the blending states.
*/
STORAGE_BUFFER(SPRITE_REMAP_BUFFER_BINDING) SpriteRemapBuffer {
    uint u_spriteRemapIndicies[];
};

//// DRAW COMMANDS BUFFER ////

STORAGE_BUFFER(DRAW_COMMAND_BUFFER_BINDING) DrawCommandBuffer {
    DrawCommand u_drawCommands[];
};

//// GLOBALS ////
uint objectFlags;
uint objectIndex;
uint spriteType;
vec2 objectPosition;
vec2 vertexOffset;
float cullingRadius = 0.0;

//// HELPER FUNCTION PREDECLARATIONS ////
bool isObjectOnScreen();
float calculateAudioScale();
vec4 calculateInvisibleBlockColorAndOpacity(vec4 color);
vec4 applyHSV(HSV hsvValue, vec4 color);

//// PROCESS SPRITE FUNCTION ////
uint processSprite(uint spriteIndex) {
    if (spriteIndex >= u_preCulledSprites.length() || spriteIndex >= u_inputSprites.length() ||
        spriteIndex >= u_rawSprites.length()) return 0;
    PreCulledSprite pcSprite = u_preCulledSprites[spriteIndex];
    if (pcSprite.groupCombinationIndex >= u_groupCombinationStates.length()) return 0;

    //// APPLY GROUP COMBINATION STATE ////
    GroupCombinationState state = u_groupCombinationStates[pcSprite.groupCombinationIndex];
    objectPosition = state.positionalTransform * pcSprite.startPosition + state.offset;

    InputSprite sprite = u_inputSprites[spriteIndex];
    objectIndex = sprite.objectIndex;
    if (objectIndex >= u_objects.length()) return 0;
    
    ObjectInfo object = u_objects[sprite.objectIndex];

    objectFlags = object.flags;
    cullingRadius = pcSprite.radius * max(1.0, length(state.localTransform[0]) + length(state.localTransform[1]));
    if ((objectFlags & OBJECT_FLAG_USES_AUDIO_SCALE) != 0)
        cullingRadius *= max(1.0, abs(calculateAudioScale()));
    if (!isObjectOnScreen()) return 0;

    //// APPLY LOCAL TRANSFORM ////
    mat2 objectLocalTransform = mat2(1.0);

    if ((objectFlags & OBJECT_FLAG_IS_STATIC_OBJECT) == 0)
        objectLocalTransform = state.localTransform;

    if (object.rotationSpeed != 0.0) // TODO: Just supply rotation speed in radians instead
        objectLocalTransform = rotationMatrix(-object.rotationSpeed * u_timer / 180 * PI) * objectLocalTransform;

    if ((objectFlags & OBJECT_FLAG_USES_AUDIO_SCALE) != 0)
        objectLocalTransform = scaleMatrix(calculateAudioScale()) * objectLocalTransform;

    //// CALCULATE OBJECT COLOR ////
    uint colorChannel;

    spriteType = sprite.spriteType;

    switch (spriteType) {
    case SPRITE_TYPE_GLOW: colorChannel = (objectFlags & OBJECT_FLAG_IS_GLOW_COLOR_LBG) != 0 ? COLOR_CHANNEL_LBG : object.baseColorChannelId; break;
    case SPRITE_TYPE_BASE:   colorChannel = object.baseColorChannelId; break;
    case SPRITE_TYPE_DETAIL: colorChannel = object.detailColorChannelId; break;
    case SPRITE_TYPE_BLACK:  colorChannel = COLOR_CHANNEL_BLACK; break;
    default: return 0;
    }
    if (colorChannel >= u_channelColors.length()) return 0;

    vec4 color = RGBA_TO_VEC4(u_channelColors[colorChannel]);

    if (spriteType == SPRITE_TYPE_GLOW && (objectFlags & OBJECT_FLAG_SPECIAL_GLOW_COLOR) != 0 &&
        (objectFlags & OBJECT_FLAG_IS_GLOW_COLOR_LBG) == 0)
        color = vec4(u_specialLightBGColor, 1.0);
    
    if ((objectFlags & OBJECT_FLAG_IS_INVISIBLE_BLOCK) != 0)
        color = calculateInvisibleBlockColorAndOpacity(color);

    if (spriteType == SPRITE_TYPE_BASE && (objectFlags & OBJECT_FLAG_HAS_BASE_HSV) != 0) {
        color = applyHSV(object.baseHSV, color);
    } else if (spriteType == SPRITE_TYPE_DETAIL && (objectFlags & OBJECT_FLAG_HAS_DETAIL_HSV) != 0) {
        color = applyHSV(object.detailHSV, color);
    }

    color.a *= state.opacity * object.opacity;
    color.rgb *= color.a;

    if (color.a <= 0.0)
        return 0;

    //// SAVE DATA INTO RAW SPRITE BUFFER ////
    u_rawSprites[spriteIndex].position = objectPosition;
    u_rawSprites[spriteIndex].localTransform = objectLocalTransform;
    u_rawSprites[spriteIndex].color = color;

    //// VALIDATE THE SPRITE INDICES ////
    uint indexEnd = sprite.indexStart + sprite.indexCount;
    if (indexEnd < sprite.indexStart || indexEnd > u_inputIndicies.length() ||
        sprite.indexCount > u_culledIndicies.length()) return 0;
    return sprite.indexCount;
}

//// MAIN FUNCTION ////
void main() {
    uint workGroupIndex = gl_WorkGroupID.x;
    if (workGroupIndex >= u_workGroups.length() || workGroupIndex >= u_drawCommands.length()) return;

    WorkGroup workGroup = u_workGroups[workGroupIndex];
    uint lane = gl_LocalInvocationIndex;
    uint sourceIndex = workGroup.inputSpriteStart + lane;
    bool valid = sourceIndex >= workGroup.inputSpriteStart && sourceIndex < workGroup.inputSpriteEnd &&
                 sourceIndex < u_spriteRemapIndicies.length();
    uint spriteIndex = valid ? u_spriteRemapIndicies[sourceIndex] : 0;
    uint count = valid ? processSprite(spriteIndex) : 0;
    visibleIndexCounts[lane] = count;
    barrier();

    // An exclusive prefix preserves painter order. Atomic append would let
    // scheduling change the order of translucent overlapping sprites.
    uint offset = 0;
    for (uint i = 0; i < lane; ++i) offset += visibleIndexCounts[i];
    uint start = workGroup.culledIndexBufferOutputIndex + offset;
    if (count > 0 && start >= workGroup.culledIndexBufferOutputIndex &&
        count <= u_culledIndicies.length() && start <= u_culledIndicies.length() - count) {
        InputSprite sprite = u_inputSprites[spriteIndex];
        for (uint i = 0; i < count; ++i) u_culledIndicies[start + i] = u_inputIndicies[sprite.indexStart + i];
    }
    if (lane == 31) {
        uint total = offset + count;
        if (workGroup.culledIndexBufferOutputIndex > u_culledIndicies.length() ||
            total > u_culledIndicies.length() - workGroup.culledIndexBufferOutputIndex) total = 0;
        u_drawCommands[workGroupIndex].count = total;
        u_drawCommands[workGroupIndex].firstIndex = workGroup.culledIndexBufferOutputIndex;
    }
}

//// HELPER FUNCTIONS ////
bool isObjectOnScreen() {
    vec2 offset = objectPosition - u_cameraPosition;
    // Degenerate camera transforms/zero zoom must never make all sprites
    // disappear merely because comparisons against NaN return false.
    if (any(isnan(offset)) || any(isinf(offset)) || isnan(cullingRadius) || isinf(cullingRadius) ||
        any(isnan(u_cameraRight)) || any(isinf(u_cameraRight)) ||
        any(isnan(u_cameraUp)) || any(isinf(u_cameraUp)) ||
        any(isnan(u_cameraSize)) || any(isinf(u_cameraSize)) ||
        any(lessThanEqual(u_cameraSize, vec2(0.0)))) return true;

    // convertToNodeSpace can produce a skewed/nonuniform camera basis. A
    // pair of dot products is its inverse only when the axes are orthogonal.
    // Project through the actual inverse basis and expand each clip axis by
    // the radius times that inverse row's length (a conservative circle bound).
    float determinant = u_cameraRight.x * u_cameraUp.y - u_cameraRight.y * u_cameraUp.x;
    if (abs(determinant) <= 1.0e-8 || isnan(determinant) || isinf(determinant)) return true;
    vec2 screenPos = vec2(u_cameraUp.y * offset.x - u_cameraUp.x * offset.y,
                         -u_cameraRight.y * offset.x + u_cameraRight.x * offset.y) / determinant;
    vec2 leeway = (max(cullingRadius, 0.0) + 2.0) *
                  vec2(length(u_cameraUp), length(u_cameraRight)) / abs(determinant);
    if (any(isnan(screenPos)) || any(isinf(screenPos)) || any(isnan(leeway))) return true;

    return screenPos.x >= -leeway.x &&
           screenPos.x <= u_cameraSize.x + leeway.x &&
           screenPos.y >= -leeway.y &&
           screenPos.y <= u_cameraSize.y + leeway.y;
}

float calculateAudioScale() {
    float scale;
    if ((objectFlags & OBJECT_FLAG_CUSTOM_AUDIO_SCALE) != 0) {
        float minScale = u_objects[objectIndex].audioScaleMin;
        float maxScale = u_objects[objectIndex].audioScaleMax;
        scale = (u_audioScale - 0.1) * (maxScale - minScale) + minScale;
    } else
        scale = u_audioScale;

    if ((objectFlags & OBJECT_FLAG_IS_ORB) != 0)
        scale = min(scale + 0.3, 1.2);
    return scale;
}

float getRelativeMod(float xPos, float left, float right, float offset) {
    float result = u_cameraViewSize.x * 0.5;

    if (xPos > result + u_cameraPosition.x)
        result = (result - (xPos - offset - u_cameraPosition.x - result)) * right;
    else
        result = (result - (result + u_cameraPosition.x - xPos - offset)) * left;

    return clamp(result, 0.0, 1.0);
}

vec2 calculateInvisibleBlockOpacity() {
    float centerLeftX  = u_winSize.x * 0.5 - 75.0;
    float centerRightX = centerLeftX + 110.0;
    float someScreenLeft = u_screenRight - centerRightX - 90.0;

    float fadePosX = objectPosition.x;
    if (fadePosX <= u_cameraUnzoomedX)
        fadePosX += u_objects[objectIndex].fadeMargin;
    else
        fadePosX -= u_objects[objectIndex].fadeMargin;
    
    float relMod = getRelativeMod(fadePosX, 0.02, 0.014285714, 0.0);

    // INVISIBLE BLOCK OPACITY IS INACCURATE AND I CAN'T SEEM TO FIGURE IT OUT, I'M GOING CRAZY

    float someWidth1;
    if (fadePosX <= centerRightX + u_cameraPosition.x)
        someWidth1 = (centerLeftX + u_cameraPosition.x - fadePosX) / max(centerLeftX - 30.0, 1.0);
    else
        someWidth1 = (fadePosX - u_cameraPosition.x - centerRightX) / max(someScreenLeft, 1.0);

    someWidth1 = clamp(someWidth1, 0.0, 1.0);

    return vec2(
        min(someWidth1 * 0.95 + 0.05, relMod),
        min(someWidth1 * 0.85 + 0.15, relMod)
    );
}

vec4 calculateInvisibleBlockColorAndOpacity(vec4 color) {
    if ((u_gameStateFlags & GAME_STATE_IS_PLAYER_DEAD) != 0) {
        if (spriteType == SPRITE_TYPE_GLOW)
            return vec4(u_specialLightBGColor, color.a);
        return color;
    }

    vec2 opacity = calculateInvisibleBlockOpacity();

    if (spriteType != SPRITE_TYPE_GLOW) {
        color.a *= opacity.x;
    } else {
        // Might have to do some of these calculations on the cpu instead
        vec3 colorBG  = RGBA_TO_VEC4(u_channelColors[COLOR_CHANNEL_BG]).rgb;
        vec3 colorLBG = RGBA_TO_VEC4(u_channelColors[COLOR_CHANNEL_LBG]).rgb;

        vec3 colorB;
        if ((colorBG.r + colorBG.g + colorBG.b) >= (150.0 / 255.0))
            colorB = vec3(1, 1, 1);
        else
            colorB = colorLBG;

        vec3 glowColor;
        if (opacity.x <= 0.8)
            glowColor = u_specialLightBGColor;
        else
            glowColor = mix(colorB, u_specialLightBGColor, (1.0 - (opacity.x - 0.8) / 0.2) * 0.3 + 0.7);
        color = vec4(glowColor, color.a * opacity.y);
    }

    return color;
}
